## Planned Schema Additions

These are documented in `SPINE_BACKLOG.md` and not yet applied to the database:

```sql
-- Finish-gated spoiler chat
CREATE TABLE club_book_finishers (
  club_id     UUID REFERENCES clubs(id),
  book_id     UUID REFERENCES books(id),
  user_id     UUID REFERENCES profiles(id),
  quiz_passed BOOLEAN DEFAULT false,
  finished_at TIMESTAMPTZ DEFAULT NOW(),
  PRIMARY KEY (club_id, book_id, user_id)
);

ALTER TABLE club_messages ADD COLUMN channel TEXT DEFAULT 'reading'
  CHECK (channel IN ('reading', 'finished'));

-- Club book voting
CREATE TABLE club_nominations (
  id           UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  club_id      UUID REFERENCES clubs(id) ON DELETE CASCADE,
  book_id      UUID REFERENCES books(id),
  nominated_by UUID REFERENCES profiles(id),
  round        INT DEFAULT 1,
  created_at   TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE club_votes (
  nomination_id UUID REFERENCES club_nominations(id) ON DELETE CASCADE,
  user_id       UUID REFERENCES profiles(id),
  created_at    TIMESTAMPTZ DEFAULT NOW(),
  PRIMARY KEY (nomination_id, user_id)
);
```

